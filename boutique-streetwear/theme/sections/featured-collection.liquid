<section class="section{% if section.settings.dark %} section--dark{% endif %}">
  <div class="page">
    <div class="section__head" data-reveal>
      <div>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h2 class="section__title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="link-arrow" href="{{ section.settings.collection.url }}">Tout voir {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="product-row" data-slider>
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="card card--placeholder" data-reveal>
            <div class="card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'card__img placeholder' }}</div>
            <div class="card__info"><h3 class="card__title">Choisis une collection</h3><p class="price">— €</p></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collection mise en avant",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Les plus aimés" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Best-sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "dark", "label": "Fond noir", "default": false }
  ],
  "presets": [
    { "name": "Best-sellers", "settings": { "kicker": "Les plus aimés", "heading": "Best-sellers" } },
    { "name": "Nouveautés", "settings": { "kicker": "Tout juste arrivés", "heading": "Nouveautés" } }
  ]
}
{% endschema %}
