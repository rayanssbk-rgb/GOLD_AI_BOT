<section class="collection page">
  <header class="collection__head">
    <p class="kicker">Recherche</p>
    <h1 class="collection__title">{% if search.performed %}« {{ search.terms | escape }} »{% else %}Rechercher{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Hoodie, cargo, t-shirt…" aria-label="Rechercher">
      <button class="btn btn--dark" type="submit">Rechercher</button>
    </form>
  </header>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {% render 'facets', results: search, url: routes.search_url %}
      <div class="grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- else -%}
          <p class="empty">Aucun résultat. Essaie « hoodie », « cargo » ou « t-shirt ».</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>
{% schema %}
{ "name": "Résultats de recherche" }
{% endschema %}
