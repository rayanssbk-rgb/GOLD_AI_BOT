<section class="section" data-related data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page">
      <div class="section__head"><div><p class="kicker">À associer</p><h2 class="section__title">{{ section.settings.heading | escape }}</h2></div></div>
      <div class="product-row" data-slider>
        {%- for p in recommendations.products -%}{% render 'product-card', product: p %}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Produits associés", "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Vous aimerez aussi" }], "presets": [{ "name": "Produits associés" }] }
{% endschema %}
