<section class="collection page">
  <header class="collection__head" data-reveal>
    <p class="kicker">Collection</p>
    <h1 class="collection__title">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="collection__desc rte">{{ collection.description }}</div>{%- endif -%}
  </header>
  {%- paginate collection.products by section.settings.per_page -%}
    {% render 'facets', results: collection, url: collection.url %}
    <div class="grid" data-grid>
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="empty">Aucun produit ne correspond à ces filtres. <a href="{{ collection.url }}">Tout afficher</a></p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "Collection",
  "settings": [{ "type": "range", "id": "per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 24 }]
}
{% endschema %}
