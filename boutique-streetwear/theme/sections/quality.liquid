<section class="section section--cream quality">
  <div class="page quality__grid">
    <div class="quality__media" data-reveal>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'quality__img', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'quality__img placeholder' }}
      {%- endif -%}
    </div>
    <div class="quality__text">
      <p class="kicker" data-reveal>{{ section.settings.kicker | escape }}</p>
      <h2 class="section__title" data-reveal>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="quality__intro" data-reveal>{{ section.settings.text }}</div>{%- endif -%}
      <ul class="quality__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }} data-reveal>
            <span class="quality__icon">{% render 'icon', name: block.settings.icon %}</span>
            <div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Qualité et confort",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Notre exigence" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le détail fait la différence." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Chaque pièce est choisie pour son tombé, son épaisseur et ses finitions. Décris ici tes vraies matières et tes vraies garanties.</p>" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point fort",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "feather", "options": [
          { "value": "feather", "label": "Douceur" }, { "value": "snow", "label": "Froid" }, { "value": "thread", "label": "Fil / matière" },
          { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retours" }, { "value": "lock", "label": "Paiement" }, { "value": "heart", "label": "Cœur" } ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Doux au toucher" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Des mailles agréables, qui ne grattent pas." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Qualité et confort",
      "blocks": [
        { "type": "point", "settings": { "icon": "thread", "title": "Matières épaisses", "text": "Des cotons et molletons qui tiennent leur forme, lavage après lavage." } },
        { "type": "point", "settings": { "icon": "feather", "title": "Coupes étudiées", "text": "Épaules tombantes, volumes amples, longueurs justes." } },
        { "type": "point", "settings": { "icon": "heart", "title": "Finitions nettes", "text": "Coutures propres, côtes solides, logos discrets." } }
      ]
    }
  ]
}
{% endschema %}
