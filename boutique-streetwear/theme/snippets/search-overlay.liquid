<div class="search-overlay" id="SearchOverlay" role="dialog" aria-modal="true" aria-label="Recherche" aria-hidden="true" data-search-overlay>
  <div class="search-overlay__panel">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
      <input type="hidden" name="type" value="product">
      {% render 'icon', name: 'search' %}
      <input class="search-overlay__input" type="search" name="q" placeholder="Rechercher un hoodie, un cargo…" autocomplete="off" aria-label="Rechercher" data-search-input>
      <button class="icon-btn" type="button" data-search-close aria-label="Fermer la recherche">{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="search-overlay__results" data-search-results aria-live="polite"></div>
  </div>
  <div class="search-overlay__scrim" data-search-close></div>
</div>
