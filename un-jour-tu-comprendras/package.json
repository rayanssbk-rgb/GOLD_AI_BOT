{
  "name": "un-jour-tu-comprendras",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "voice": "python3 scripts/select_voice.py $PIPER_BIN $PIPER_MODEL 8 && python3 scripts/align_subs.py",
    "audio": "node scripts/generate-audio.mjs",
    "studio": "remotion studio src/index.ts",
    "render:a": "remotion render src/index.ts UnJour out/partA.mp4 --frames=0-1259 --concurrency=1 --gl=swangle --muted --codec=h264 --crf=12",
    "render:b": "remotion render src/index.ts UnJour out/partB.mp4 --frames=1260-2489 --concurrency=1 --gl=swangle --muted --codec=h264 --crf=12",
    "assemble": "bash scripts/assemble.sh",
    "render": "npm run audio && npm run render:a && npm run render:b && npm run assemble",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "postprocessing": "6.36.4",
    "@remotion/three": "4.0.290",
    "@remotion/cli": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/three": "0.169.0",
    "typescript": "5.6.3"
  }
}
