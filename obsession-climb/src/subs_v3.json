[
 {
  "text": "Écoute bien, parce que ça,",
  "start": 0.29,
  "spoken": 1.75,
  "end": 1.85
 },
 {
  "text": "peu de gens le comprennent.",
  "start": 1.89,
  "spoken": 2.97,
  "end": 3.01
 },
 {
  "text": "L’obsession,",
  "start": 3.05,
  "spoken": 3.65,
  "end": 3.87
 },
 {
  "text": "ce n’est pas simplement vouloir réussir.",
  "start": 3.91,
  "spoken": 5.83,
  "end": 5.99
 },
 {
  "text": "C’est penser à ton objectif,",
  "start": 6.03,
  "spoken": 7.65,
  "end": 7.65
 },
 {
  "text": "même quand personne ne croit en toi.",
  "start": 7.69,
  "spoken": 9.31,
  "end": 9.41
 },
 {
  "text": "Pendant que certains dorment, toi,",
  "start": 9.45,
  "spoken": 10.99,
  "end": 11.21
 },
 {
  "text": "tu construis.",
  "start": 11.25,
  "spoken": 11.91,
  "end": 11.91
 },
 {
  "text": "Pendant que certains se moquent,",
  "start": 11.95,
  "spoken": 13.27,
  "end": 13.37
 },
 {
  "text": "toi, tu progresses.",
  "start": 13.41,
  "spoken": 14.61,
  "end": 14.73
 },
 {
  "text": "Tu vas connaître des échecs,",
  "start": 14.77,
  "spoken": 16.15,
  "end": 16.23
 },
 {
  "text": "des doutes,",
  "start": 16.27,
  "spoken": 16.85,
  "end": 16.89
 },
 {
  "text": "des moments où tu voudras tout abandonner.",
  "start": 16.93,
  "spoken": 18.83,
  "end": 19.18
 },
 {
  "text": "Mais c’est justement là que tout se joue.",
  "start": 19.51,
  "spoken": 21.35,
  "end": 21.41
 },
 {
  "text": "La motivation te donne envie de commencer.",
  "start": 21.45,
  "spoken": 23.39,
  "end": 23.74
 },
 {
  "text": "L’obsession, elle,",
  "start": 24.51,
  "spoken": 25.57,
  "end": 25.69
 },
 {
  "text": "te pousse à continuer quand tu n’as plus envie.",
  "start": 25.73,
  "spoken": 27.85,
  "end": 27.93
 },
 {
  "text": "Alors arrête de parler de tes projets.",
  "start": 27.97,
  "spoken": 29.75,
  "end": 29.65
 },
 {
  "text": "Travaille en silence.",
  "start": 29.69,
  "spoken": 30.91,
  "end": 30.81
 },
 {
  "text": "Et laisse tes résultats parler pour toi.",
  "start": 30.85,
  "spoken": 32.87,
  "end": 33.22
 }
]