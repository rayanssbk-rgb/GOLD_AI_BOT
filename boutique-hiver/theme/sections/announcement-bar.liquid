{%- if section.blocks.size > 0 -%}
<div class="announce" role="region" aria-label="Annonces" data-announce>
  <div class="announce__track">
    {%- for block in section.blocks -%}
      <p class="announce__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Barre d'annonce",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Expédition sous 48 h · Retours sous 14 jours" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Barre d'annonce", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
