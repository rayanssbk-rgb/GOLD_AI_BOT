{%- comment -%}
  Usage: {% render 'price', product: product, variant: variant %}
  The struck-through price is ONLY shown when a real "compare at" price is set in Shopify and is higher than the price.
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
  assign varies = false
  if variant == blank and product.price_varies
    assign varies = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}" data-price>
  {%- if varies -%}<span class="price__from">À partir de</span>{%- endif -%}
  <span class="price__current">{{ target.price | money }}</span>
  {%- if on_sale -%}
    <s class="price__compare"><span class="visually-hidden">Prix normal</span>{{ target.compare_at_price | money }}</s>
  {%- endif -%}
</div>
