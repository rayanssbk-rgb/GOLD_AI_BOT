<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- liquid
      assign heading_font = settings.type_heading
      assign body_font = settings.type_body
    -%}
    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      :root {
        --c-bg: {{ settings.color_bg }}; --c-text: {{ settings.color_text }}; --c-dark: {{ settings.color_dark }};
        --c-anthracite: {{ settings.color_anthracite }}; --c-cream: {{ settings.color_cream }}; --c-ice: {{ settings.color_ice }};
        --c-line: {{ settings.color_text | color_modify: 'alpha', 0.12 }}; --c-muted: {{ settings.color_text | color_modify: 'alpha', 0.62 }};
        --f-head: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --f-head-weight: {{ heading_font.weight }};
        --f-body: {{ body_font.family }}, {{ body_font.fallback_families }}; --f-body-weight: {{ body_font.weight }};
        --radius: {{ settings.radius }}px; --page: {{ settings.page_width }}px;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" class="main">{{ content_for_layout }}</main>
  </body>
</html>
